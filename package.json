    "browser-image-compression": "^2.0.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "heic2any": "^0.0.4",
    "helmet": "^8.3.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.3",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.5",
